# Production server: one instance with a persistent volume. Never commit real secrets.
APP_ENV=production
APP_ORIGIN=https://your-app.example
APP_STATE_DIR=/data/state
PORT=8080
# Optional one-time startup migration, configured in the host process environment.
# APP_STATE_IMPORT_PATH=/data/initial-state.sqlite
# APP_STATE_IMPORT_SHA256=<verified snapshot SHA256>

# Dedicated, small relayer wallet. Keep the hub administration/recovery key offline.
INTEGRATION_ALLOW_MAINNET=false
INTEGRATION_NEAR_ACCOUNT_ID=
INTEGRATION_NEAR_PRIVATE_KEY=
INTEGRATION_MIN_TREASURY_NEAR=0.02
INTEGRATION_MAX_NEAR_FEES=0.05
INTEGRATION_MAX_NEAR_OUTFLOW=0
INTEGRATION_MAX_CONCURRENT_NEAR_ALLOCATION=0
INTEGRATION_HUB_ACCOUNT_ID=
INTEGRATION_HUB_CODE_HASH=
INTEGRATION_DEFAULT_ARBITER_ID=
APP_KEEPER_ENABLED=false
APP_NEAR_RPC_INTERVAL_MS=250

# Public media and cross-chain routing credentials, supplied as hosting secrets.
INTEGRATION_IPFS_PINNING_TOKEN=
INTEGRATION_ONECLICK_API_KEY=
APP_CUSTOMER_ROUTE_MAX_USDC=1000
APP_MEDIA_MAX_BYTES=20000000
APP_MEDIA_MAX_TOTAL_BYTES=1000000000
# Reserve local disk for payment journals; this limit may only be lowered.
APP_LOCAL_PHOTO_MAX_BYTES=134217728

# Optional personal scanner. Pair only your own wallets with your local companion.
# ChatGPT OAuth credentials stay on your computer and never enter the hosted server.
APP_PERSONAL_AI_WALLETS=
APP_PERSONAL_AI_TOKEN=
APP_AI_DAILY_LIMIT=5
APP_AI_GLOBAL_DAILY_LIMIT=25

# Public vehicle onboarding. Separate NEAR Builders/NEAR AI server credential.
NEAR_AI_API_KEY=
NEAR_AI_MODEL=z-ai/glm-5.3-flash
NEAR_AI_IMAGE_MODEL=black-forest-labs/FLUX.2-klein-4B
