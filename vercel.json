{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": { "deploymentEnabled": { "local/low-cost-integration": false } },
  "framework": "vite",
  "installCommand": "npm ci --prefix prototype --ignore-scripts",
  "buildCommand": "npm run build --prefix prototype",
  "outputDirectory": "prototype/dist",
  "devCommand": "npm run dev --prefix prototype",
  "redirects": [
    {
      "source": "/",
      "destination": "https://web-production-3ff8f.up.railway.app/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "destination": "https://web-production-3ff8f.up.railway.app/:path*",
      "permanent": false
    }
  ]
}
